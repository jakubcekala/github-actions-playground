# Flagsmith Cloud (https://app.flagsmith.com)
# Copy this file to .env.local and fill in your keys.

# Client-side Environment Key — public by design, shipped to the browser.
# Gates the beta_counter feature (client-side flag).
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_KEY=

# Server-side Environment Key — secret, never exposed to the client.
# Gates the beta_banner feature (server-side flag).
FLAGSMITH_SERVER_SIDE_ENVIRONMENT_KEY=
